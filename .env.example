# Copy this file to `.env` and fill in the values you need.
# `.env` is gitignored — never commit real credentials.

# Azure AD "public client" application ID that enables Microsoft sign-in.
# Create one in the Azure portal, then register it with your Noxara Labs app.
# Without this, Microsoft sign-in is disabled (offline profiles still work).
NOXARA_MSA_CLIENT_ID=

# Discord application ID that enables Rich Presence.
# Create an application at https://discord.com/developers/applications and upload
# a Rich Presence asset named `noxara_logo` for the large image.
NOXARA_DISCORD_APP_ID=